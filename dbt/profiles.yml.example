# Template only. Every value comes from the environment, so this file never holds a secret.
# Locally:  cp dbt/profiles.yml.example dbt/profiles.yml   (gitignored), then run dbt through
#           scripts/with-databricks, which exports the three DATABRICKS_* variables.
# CI:       generated from the GitHub Actions secrets of the same names.
auctionvault:
  target: prod
  outputs:
    prod:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') | replace('https://', '') | replace('/', '') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: auction
      schema: silver
      threads: 4
